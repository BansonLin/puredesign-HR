# Copy to .env.local for local development (connects to the Supabase staging project).
# Never commit real values. See CLAUDE.md §4.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_TIMEZONE=Asia/Taipei
APP_BASE_URL=http://localhost:3000

# Seed (PLAN A03 / 4.9.2): password for every seed account (`pnpm db:seed`
# aborts when unset); seed refuses to run against any project whose ref
# (the <ref> in https://<ref>.supabase.co) is not the one listed here.
# Local supabase CLI stack (http://127.0.0.1:54321): SEED_ALLOWED_PROJECT_REF=local
SEED_PASSWORD=change-me
SEED_ALLOWED_PROJECT_REF=your-project-ref

# Provided by the toolchain, never set here (T30 §13 audit): `NODE_ENV` is set
# by next / vitest and setting it in .env.local breaks the Next.js build;
# `CI` is set by GitHub Actions. They are the only other names that
# `grep -rho "process\.env\.[A-Z_]*" app lib supabase tests middleware.ts`
# reports, and every remaining name above is a variable this app owns.
