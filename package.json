{
  "name": "pure-onboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local --schema public > lib/db/types.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local supabase/seed/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.0",
    "radix-ui": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "supabase": "^2.20.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
